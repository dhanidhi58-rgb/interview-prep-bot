
# Set AI_PROVIDER to one of: mock, openai, anthropic
AI_PROVIDER=mock

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional model override. If blank, sensible defaults are used per provider.
MODEL_NAME=

# SQLite database location
DATABASE_URL=sqlite:///storage/interview_prep.db
